# macOS
.DS_Store
**/.DS_Store

# Xcode — per-developer UI state, never shared. Tracking xcschememanagement.plist
# made every build dirty the tree and blocked merges.
**/xcuserdata/
*.xcuserstate

# PocketBase -> Convex migration source data.
# Contains production PII: real user emails/names, chat message bodies and home
# invite codes (an invite code grants membership via homes:join). Keep local only.
backend/data/

# graphify generated artifacts. graph.json / GRAPH_REPORT.md are tracked on purpose
# (CLAUDE.md workflow depends on them); the AST cache and dated snapshots are not.
graphify-out/cache/
graphify-out/20*/
