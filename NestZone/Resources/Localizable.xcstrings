    "calendar_leftovers_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything still unbought for “%@” comes off the list. Anything someone still needs can be added again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” için alınmayan her şey listeden çıkar. Lazım olan olursa tekrar eklersin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt som inte har köpts till ”%@” tas bort från listan. Behöver någon fortfarande något går det att lägga till igen."
          }
        }
      }
    },
