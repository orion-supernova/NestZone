    "plus_feature_calendar_text": {
      "comment": "Plus details row text: what the calendar does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One calendar for the house. Invite housemates, see who's coming and get a reminder before it starts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evin tek takvimi. Ev arkadaşlarını davet et, kimlerin geleceğini gör, başlamadan önce hatırlatma al."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En kalender för hela hemmet. Bjud in de du bor med, se vem som kommer och få en påminnelse innan det drar igång."
          }
        }
      }
    },
    "plus_feature_event_title": {
      "comment": "Plus details row title: making an event from outside the Calendar.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add events from anywhere"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yerden etkinlik ekle"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till händelser var som helst"
          }
        }
      }
    },
    "plus_feature_event_text": {
      "comment": "Plus details row text: events made from the dinner sheet, the dock's + button (Add anything).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn a dinner into an occasion, or file an event from the + button, without opening the Calendar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yemeği davete çevir ya da Takvim'i açmadan alttaki + düğmesinden etkinlik ekle."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör en middag till en grej, eller lägg in en händelse med +-knappen, utan att öppna Kalendern."
          }
        }
      }
    },
    "plus_feature_money_title": {
      "comment": "Plus details row title: the Money module.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared money"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortak harcamalar"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delade pengar"
          }
        }
      }
