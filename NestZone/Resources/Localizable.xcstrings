    "home_delete_confirm_action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Home"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
