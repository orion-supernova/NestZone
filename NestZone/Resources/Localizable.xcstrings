        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Plus covers %lld of %lld homes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus'ın şu an %1$lld evi kapsıyor (en fazla %2$lld)."
