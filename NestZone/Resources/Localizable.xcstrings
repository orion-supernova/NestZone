      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put finished chores away yourself, instead of waiting for them to move to the Archive on their own."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biten işleri kendin arşive kaldır, kendiliğinden taşınmasını bekleme."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
