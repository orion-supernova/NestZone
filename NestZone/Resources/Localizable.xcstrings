    "tasks_done_window_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished in the last %lld days. Older ones move to the Archive, and you can put one there sooner — either way it still counts towards contributions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %lld günde tamamlananlar. Daha eskiler Arşiv'e taşınır, istersen erkenden de kaldırabilirsin — her durumda katkılara sayılır."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klart de senaste %lld dagarna. Äldre flyttas till Arkivet, och du kan lägga dit en tidigare – det räknas in i vem gör vad i alla fall."
          }
        }
      }
    },
