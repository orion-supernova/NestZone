    "paywall_renews_note": {
      "comment": "One short line directly under the purchase button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Renews automatically. Cancel anytime in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik yenilenir. İstediğin zaman Ayarlar'dan iptal edebilirsin."
          }
        }
      }
    },
    "paywall_disclosure_full": {
      "comment": "Full App Store subscription disclosure above Terms and Privacy on the paywall. Keep every point: charged to Apple Account at confirmation, auto-renews unless cancelled 24h before period end, renewal charged within 24h before, manage in Apple Account settings, unused trial is forfeited on purchase.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your Apple Account when you confirm the purchase. The subscription renews automatically unless you cancel it at least 24 hours before the end of the current period, and your account is charged for the renewal within 24 hours before the period ends. You can manage or cancel it any time in your Apple Account settings. Any unused part of a free trial is forfeited when you buy a subscription."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme, satın almayı onayladığında Apple Hesabından tahsil edilir. Mevcut dönem bitmeden en az 24 saat önce iptal etmezsen abonelik otomatik yenilenir; yenileme ücreti de dönem bitmeden önceki 24 saat içinde Apple Hesabından alınır. Aboneliği istediğin zaman Apple Hesabı ayarlarından yönetebilir ya da iptal edebilirsin. Ücretsiz denemenin kullanılmayan kısmı, abone olduğunda sona erer."
          }
        }
      }
    },
