    "customize_today_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic shows a section only when there's something in it. Drag to reorder. Turning one off doesn't remove anything: it's all still in Lists, Plans and House."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik'te bir bölüm sadece içinde bir şey olduğunda görünür. Sıralamak için sürükle. Bir bölümü kapatman hiçbir şeyi silmez, hepsi Listeler, Planlar ve Ev sekmelerinde durur."
          }
        }
      }
    },
