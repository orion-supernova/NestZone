    "customize_auto_movie_night": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows up on Friday and Saturday evenings, and while a round is open."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuma ve cumartesi akşamları, bir de açık bir tur varken görünür."
          }
        }
      }
    },
    "customize_auto_needs_you": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows urgent repairs and bills due in the next few days."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acil onarımları ve birkaç gün içinde ödenecek faturaları gösterir."
          }
        }
      }
    },
    "customize_auto_stats": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows only the counts that need something, like what's left to buy. Always shows every counter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bir şey bekleyen sayıları gösterir, alınacaklar gibi. Her zaman seçilirse bütün sayılar görünür."
          }
        }
      }
    },
    "customize_auto_tasks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows chores that are due, yours, and ones nobody has taken yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanı gelen görevleri, sizinkileri ve henüz kimsenin üstlenmediklerini gösterir."
          }
        }
      }
    },
    "customize_auto_tonight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows dinner once somebody has decided it. In the evening, the bar above the tabs asks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşam yemeğine karar verildiğinde görünür. Akşamları sekmelerin üstündeki çubuk sorar."
          }
        }
      }
    },
    "customize_auto_up_next": {
