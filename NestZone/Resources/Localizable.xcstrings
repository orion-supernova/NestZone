    "task_archive_delete_message_mine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This also removes your credit for finishing it, so the contribution split will change. It can't be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işi bitirdiğin için yazılan pay da gider, katkı dağılımı değişir. Geri dönüşü yok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Då försvinner också att du gjorde den, så fördelningen ändras. Det går inte att ångra."
          }
        }
      }
    },
    "task_archive_delete_message_other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This also removes %@'s credit for finishing it, so the contribution split will change. It can't be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu işi bitirdiği için aldığı payı da kaybeder, katkı dağılımı değişir. Geri dönüşü yok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Då försvinner också att %@ gjorde den, så fördelningen ändras. Det går inte att ångra."
          }
        }
      }
    },
    "task_archive_delete_message_unattributed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This also removes it from the contribution split. It can't be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katkı dağılımından da çıkar. Geri dönüşü yok."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den försvinner då också ur fördelningen. Det går inte att ångra."
          }
        }
      }
    },
    "task_archive_delete_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%@” for good?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” kalıcı olarak silinsin mi?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Radera ”%@” för gott?"
          }
        }
      }
    },
    "task_archive_empty_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished chores move here %lld days after you tick them off."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biten işler, tik attıktan %lld gün sonra buraya taşınır."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klara sysslor hamnar här %lld dagar efter att du bockat av dem."
          }
        }
      }
    },
    "task_archive_empty_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here yet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada henüz bir şey yok"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget här än"
          }
        }
      }
    },
    "task_archive_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chores finished more than %lld days ago, plus any you put away early. They still count towards contributions — deleting one is the only thing that changes that."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld günden eski işler ve erkenden kaldırdıkların burada. Katkıya sayılmaya devam ederler; bunu sadece silmek değiştirir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sysslor som blev klara för mer än %lld dagar sen, plus de du har lagt undan tidigare. De räknas fortfarande in i vem gör vad – bara att ta bort en ändrar det."
          }
        }
      }
    },
    "task_archive_restore_action": {
      "extractionState": "manual",
      "localizations": {
