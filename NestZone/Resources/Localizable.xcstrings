    "calendar_copy_housemates_footer": {
      "comment": "Footer of the housemates section",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each one gets its own calendar on your phone, named “NestZone · Name”, so you can hide it with one tap in any calendar app."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her biri telefonunda “NestZone · İsim” adlı kendi takvimine kavuşur, istediğin an tek dokunuşla gizleyebilirsin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Var och en får en egen kalender i telefonen, ”NestZone · Namn”, så du kan dölja den med ett tryck i vilken kalenderapp som helst."
          }
        }
      }
    },
