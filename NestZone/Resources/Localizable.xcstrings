    "plus_feature_messages_text": {
      "comment": "Plus details row text: what Messages does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Talk with the whole house or in smaller groups, and put a question to a vote with a poll."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bütün evle ya da küçük gruplarla yazış, bir konuyu anketle oylamaya aç."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prata med hela hemmet eller i mindre grupper, och låt en omröstning avgöra."
          }
        }
      }
    },
    "plus_feature_shopping_title": {
      "comment": "Plus details row title: shopping categories.",
