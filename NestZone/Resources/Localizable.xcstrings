      }
    },
    "notif_feed_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This only changes what buzzes your phone. The bell on every tab keeps everything. Your choices follow you to every phone and every home."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sadece telefonunun ne zaman öteceğini değiştirir. Her sekmedeki zil hepsini tutmaya devam eder. Seçimlerin her telefonunda ve her evde geçerli."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här ändrar bara vad som plingar i mobilen. Klockan på varje flik har kvar allt. Dina val följer med till alla dina mobiler och alla hem."
          }
        }
      }
    },
