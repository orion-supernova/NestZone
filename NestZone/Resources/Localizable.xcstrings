    "calendar_share_missing_footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't see your Google or work calendar? NestZone reads the iPhone's Calendar, not the Google Calendar app. Add the account in Settings → Apps → Calendar → Calendar Accounts and it shows up here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google ya da iş takvimin listede yok mu? NestZone iPhone'un Takvim'ini okuyor, Google Takvim uygulamasını değil. Hesabını Ayarlar → Uygulamalar → Takvim → Takvim Hesapları'ndan ekle, burada görünür."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser du inte din Google- eller jobbkalender? NestZone läser iPhones Kalender, inte Google Kalender-appen. Lägg till kontot under Inställningar → Appar → Kalender → Kalenderkonton så dyker den upp här."
          }
        }
      }
    },
