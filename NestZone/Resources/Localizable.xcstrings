    "customize_auto_movie_night": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows up on Friday and Saturday evenings, and while a round is open."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuma ve cumartesi akşamları, bir de açık bir tur varken görünür."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Syns fredag- och lördagkvällar, och när en runda är igång."
          }
        }
      }
    },
    "customize_auto_needs_you": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows urgent repairs and bills due in the next few days."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acil tamirler ve birkaç gün içinde ödenecek faturalar burada görünür."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar akuta reparationer och räkningar som ska betalas de närmaste dagarna."
          }
        }
      }
    },
    "customize_auto_stats": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows only the counters that need something, like what's left to buy. Pick Always to see them all."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece ilgilenmen gereken sayaçlar görünür, mesela alınacaklar. Her zaman'ı seçersen hepsi çıkar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar bara räknarna som kräver något, som det som är kvar att handla. Välj Alltid för att se alla."
          }
        }
      }
    },
    "customize_auto_tasks": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows chores that are due, yours, and ones nobody has taken yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günü gelen, sana ait ve henüz kimsenin almadığı işler burada görünür."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar sysslor som ska göras, dina egna och de som ingen har tagit än."
          }
        }
      }
    },
    "customize_auto_tonight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows dinner once somebody has decided it. In the evening, the bar above the tabs asks."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akşam yemeğine karar verildiğinde görünür. Akşamları sekmelerin üstündeki çubuk sorar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar middagen när någon har bestämt den. På kvällen frågar raden ovanför flikarna."
          }
        }
      }
    },
    "customize_auto_up_next": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows what's next in the calendar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimde sıradaki şey burada görünür."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar vad som är näst på tur i kalendern."
          }
        }
      }
    },
    "customize_reset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
