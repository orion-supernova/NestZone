        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt Plus gäller %lld av %lld hem."
          }
        }
      }
    },
    "plus_free_title": {
      "comment": "Section title on the Plus details page for what a house without Plus keeps.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What stays free"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar hep bedava"
          }
        },
        "sv": {
