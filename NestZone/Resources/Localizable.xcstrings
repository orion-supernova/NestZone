    "dock_meaning_automatic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows what's on right now: an event, tonight's dinner or a movie round."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O an ne varsa onu gösterir: bir etkinlik, bu akşamın yemeği ya da film gecesi."
          }
        }
      }
    },
    "dock_meaning_always": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always shows this one. When there's nothing yet, it asks instead."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hep bunu gösterir. Henüz bir şey yoksa sorar."
          }
        }
      }
    },
    "dock_meaning_add_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just the bar with the +, nothing else."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece + olan çubuk, başka bir şey yok."
          }
        }
      }
    },
    "dock_meaning_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No bar. Add anything moves to the + at the top."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çubuk yok. Bir şey ekle, üstteki + düğmesine taşınır."
          }
        }
      }
    },
    "dock_needs_plus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
