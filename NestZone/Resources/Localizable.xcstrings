    "plus_feature_homes_title": {
      "comment": "Plus details row title: a second home.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than one home"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla ev"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
