    "calendar_access_body": {
      "comment": "Explainer body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NestZone can put house events in the calendars you choose, and show your housemates the calendars you pick to share. Copies stay on your phone. Only calendars you share are sent, and with Busy only that is nothing but the times."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NestZone ev etkinliklerini seçtiğin takvimlere ekleyebilir, istersen seçtiğin takvimleri evdekilere de gösterebilir. Kopyalar telefonunda kalır. Sadece paylaşmayı seçtiğin takvimler gönderilir; Sadece meşgul seçersen yalnızca saatler gider."
          }
        }
      }
    },
