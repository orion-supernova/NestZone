    "moderation_delete_message": {
      "comment": "Body of the confirmation before a moderator deletes reported content",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's removed for everyone and can't be brought back. Every open report about it is closed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkes için silinir ve geri getirilemez. Bununla ilgili açık şikayetlerin hepsi kapanır."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det försvinner för alla och går inte att få tillbaka. Alla öppna anmälningar om det stängs."
          }
        }
      }
    },
