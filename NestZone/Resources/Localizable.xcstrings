    "settings_delete_account_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile and your place in every house are deleted for good. A house you're the last member of is deleted with everything in it. Things you wrote for the house stay for the others. Apple will ask you to confirm next."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilin ve bütün evlerdeki yerin kalıcı olarak silinir. Son üyesi olduğun ev de içindekilerle birlikte gider. Eve yazdıkların diğerlerinde kalır. Sıradaki adımda Apple onay isteyecek."
          }
        }
      }
    },
    "settings_delete_account_wrong_apple": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's a different Apple ID from the one you signed in with. Nothing was deleted. Try again with the same one."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, giriş yaptığın Apple Hesabı değil. Hiçbir şey silinmedi; aynı hesapla tekrar dene."
          }
        }
      }
    },
    "settings_delete_account_confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
