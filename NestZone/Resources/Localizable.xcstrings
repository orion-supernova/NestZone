    "home_delete_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're the last member of %@. Leaving deletes it and everything in it — tasks, notes, lists, recipes and messages. This can't be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ evindeki son üyesin. Ayrılırsan ev ve içindeki her şey silinir — görevler, notlar, listeler, tarifler ve mesajlar. Bu geri alınamaz."
          }
        }
      }
    },
