{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@": {
      "comment": "A step number. The argument is the step number.",
      "isCommentAutoGenerated": true
    },
    "%@: %@": {
      "comment": "A label that combines the sender's name and the message content.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@: %2$@"
          }
        }
      }
    },
    "%@s": {
      "comment": "A decade, in the form of a number followed by the letter \"s\".",
      "isCommentAutoGenerated": true
    },
    "+%@": {
      "comment": "A plus sign overlaying a circle in the avatar stack, showing the number of members not shown.",
      "isCommentAutoGenerated": true
    },
