            "state": "translated",
            "value": "Det här är gratis"
          }
        }
      }
    },
    "plus_free_readable": {
      "comment": "Plus details free row: existing data stays readable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you've already written stays yours and readable, even without Plus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yazdıkların yerinde kalır, Plus olmasa da okumaya devam edersin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt du redan har skrivit är ditt och går att läsa, även utan Plus."
          }
        }
      }
    },
    "plus_free_tasks": {
      "comment": "Plus details free row.",
