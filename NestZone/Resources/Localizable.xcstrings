      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Group the shopping list by aisle, and clear a whole aisle at once."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışveriş listesini reyonlara göre grupla, bir reyonu tek dokunuşla temizle."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela upp inköpslistan per avdelning, och bocka av en hel avdelning på en gång."
          }
        }
      }
    },
    "plus_feature_archive_title": {
      "comment": "Plus details row title: archiving finished chores by hand.",
