    "task_archive_delete_message_other": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This also removes %@'s credit for finishing it, so the contribution split will change. It can't be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, %@ adlı kişinin işi tamamlama kredisini de siler; katkı dağılımı değişir. Geri alınamaz."
          }
        }
      }
    },
    "task_archive_delete_message_unattributed": {
      "extractionState": "manual",
