      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This also removes your credit for finishing it, so the contribution split will change. It can't be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işi bitirdiğin için yazılan pay da gider, katkı dağılımı değişir. Geri dönüşü yok."
          }
        }
      }
    },
    "task_archive_delete_message_other": {
      "extractionState": "manual",
      "localizations": {
