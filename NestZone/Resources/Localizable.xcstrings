    "home_delete_confirm_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're the last member of %@. Leaving deletes it and everything in it — tasks, notes, lists, recipes and messages. This can't be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ evinde kalan son kişi sensin. Ayrılırsan ev ve içindeki her şey silinir: işler, notlar, listeler, tarifler ve mesajlar. Bunu geri alamazsın."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är den sista kvar i %@. Lämnar du raderas hemmet och allt i det: sysslor, anteckningar, listor, recept och meddelanden. Det går inte att ångra."
          }
        }
      }
    },
