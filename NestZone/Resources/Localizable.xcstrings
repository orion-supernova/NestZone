    "calendar_access_title": {
      "comment": "Explainer shown before the system calendar permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your calendars"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvimlerini kullan"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd dina kalendrar"
          }
        }
      }
    },
    "calendar_access_body": {
      "comment": "Explainer body",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NestZone can put house events in the calendars you choose, and show your housemates the calendars you pick to share. Copies stay on your phone. Only calendars you share are sent, and with Busy only that is nothing but the times."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NestZone ev etkinliklerini seçtiğin takvimlere ekleyebilir, istersen seçtiğin takvimleri evdekilere de gösterebilir. Kopyalar telefonunda kalır. Sadece paylaşmayı seçtiğin takvimler gönderilir; “Sadece meşgul” seçersen yalnızca saatler gider."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NestZone kan lägga in hemmets händelser i de kalendrar du väljer, och visa dem du bor med de kalendrar du väljer att dela. Kopiorna stannar i din telefon. Bara kalendrar du delar skickas, och med Bara upptagen skickas bara tiderna."
          }
        }
      }
    },
    "calendar_access_continue": {
      "comment": "Explainer's button; leads to the system prompt",
