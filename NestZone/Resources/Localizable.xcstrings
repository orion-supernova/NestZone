    "notifications_prompt_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a notification when someone adds a task, a shopping item, a note or plans dinner. You can change this any time in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biri iş, alışveriş maddesi ya da not eklediğinde veya akşam yemeği planladığında haber alırsın. İstediğin zaman Ayarlar'dan değiştirebilirsin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Få en notis när någon lägger till en syssla, något att handla, en anteckning eller planerar middag. Du kan ändra det när du vill i Inställningar."
          }
        }
      }
    },
