    "task_archive_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chores finished more than %lld days ago, plus any you put away early. They still count towards contributions — deleting one is the only thing that changes that."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld günden önce tamamlanan işler ve erkenden kaldırdıkların. Katkılara sayılmaya devam ederler — bunu değiştiren tek şey silmektir."
          }
        }
      }
    },
