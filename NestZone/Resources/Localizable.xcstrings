    "plus_feature_homes_text": {
      "comment": "Plus details row text: the second-home feature; also states the two-home cap.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create or join a second home. One subscription covers up to two homes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İkinci bir ev kur ya da birine katıl. Tek abonelik en fazla iki evi kapsar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa eller gå med i ett hem till. En prenumeration räcker till två hem."
          }
        }
      }
    },
    "plus_coverage": {
      "comment": "Quiet line on the Plus details page and in Settings, shown only to the person who pays. First number is homes covered, second is the cap, then the home names, comma-separated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Plus covers %lld of %lld homes: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus'ın şu an %1$lld evi kapsıyor (en fazla %2$lld): %3$@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt Plus gäller %lld av %lld hem: %@"
          }
        }
      }
    },
