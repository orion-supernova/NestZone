    "paywall_disclosure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your Apple ID when you confirm. The subscription renews by itself unless you cancel it at least 24 hours before the period ends, and you can manage or cancel it any time in your Apple ID settings. A free trial turns into a paid subscription when it ends."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme, onayladığın anda Apple Hesabı'ndan alınır. Dönem bitmeden en az 24 saat önce iptal etmezsen abonelik kendiliğinden yenilenir. Apple Hesabı ayarlarından istediğin zaman yönetebilir ya da iptal edebilirsin. Ücretsiz deneme bitince ücretli aboneliğe geçer."
          }
        }
      }
    },
    "paywall_billed_yearly_note": {
      "comment": "Small line on the yearly plan card. %@ is the per-month equivalent price (e.g. $1.67). Must make clear it bills once a year and renews; the per-month figure is only a side note.",
