    "calendar_share_footer": {
      "comment": "Footer under the sharing options",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Busy only: they see when you're busy, not why. Title and place: they see those too, never notes, people or links. Updates whenever you open NestZone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece meşgul: ne zaman meşgul olduğunu görürler, nedenini görmezler. Başlık ve yer: bunları da görürler; notlar, katılımcılar ve linkler asla gitmez. NestZone'u her açtığında güncellenir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara upptagen: de ser när du är upptagen, inte varför. Rubrik och plats: de ser det också, men aldrig anteckningar, personer eller länkar. Uppdateras varje gång du öppnar NestZone."
          }
        }
      }
    },
