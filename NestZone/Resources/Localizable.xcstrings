    "plus_feature_money_text": {
      "comment": "Plus details row text: what Money does.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log shared expenses, see who owes whom, settle up, and keep track of bills and budgets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortak harcamaları gir, kim kime ne kadar borçlu gör, hesaplaş; fatura ve bütçeleri takip et."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg in delade utgifter, se vem som är skyldig vem, gör upp och håll koll på räkningar och budgetar."
          }
        }
      }
    },
    "plus_feature_expense_title": {
      "comment": "Plus details row title: logging an expense from outside Money.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log money from anywhere"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her yerden harcama ekle"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg in utgifter var som helst"
          }
        }
      }
    },
    "plus_feature_expense_text": {
      "comment": "Plus details row text: expenses made from the + button (Add anything) or from a house problem.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add an expense from the + button or from a problem's cost, not only from Money."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harcamayı yalnızca Para bölümünden değil, + düğmesinden ya da bir sorunun maliyetinden de ekleyebilirsin."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg in en utgift med +-knappen eller från vad ett problem kostade, inte bara under Pengar."
          }
        }
      }
    },
    "plus_feature_issues_title": {
      "comment": "Plus details row title: the Problems module.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "House problems"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev sorunları"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fel & fix"
          }
        }
      }
    },
    "plus_feature_issues_text": {
      "comment": "Plus details row text: what house problems do.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep track of what's broken. Add photos, costs and parts, hand it to someone and book a visit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde neyin bozuk olduğunu takip et. Fotoğraf, maliyet ve parça ekle, birine ver, tamirci ayarla."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll koll på vad som är trasigt. Lägg till bilder, kostnader och delar, ge det till någon och boka ett besök."
          }
        }
      }
    },
    "plus_feature_messages_title": {
      "comment": "Plus details row title: Messages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "House chat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ev sohbeti"
          }
        },
        "sv": {
