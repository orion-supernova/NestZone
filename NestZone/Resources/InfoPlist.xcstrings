      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So you can take a profile photo without leaving NestZone. The camera opens only when you tap Take Photo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NestZone'dan çıkmadan profil fotoğrafı çekebilmen için. Kamera yalnızca Fotoğraf Çek'e dokunduğunda açılır."
          }
        }
      }
    }
  },
  "version": "1.1"
