    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NestZone puts house events in the calendars you choose, and shows your housemates the calendars you choose to share. Nothing is shared until you pick it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NestZone, ev etkinliklerini seçtiğin takvimlere ekler ve ev arkadaşlarına paylaşmayı seçtiğin takvimleri gösterir. Sen seçmeden hiçbir şey paylaşılmaz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NestZone lägger hemmets händelser i de kalendrar du väljer och visar de du bor med de kalendrar du väljer att dela. Inget delas förrän du väljer det."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So you can take a profile photo without leaving NestZone. The camera opens only when you tap Take Photo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NestZone'dan çıkmadan profil fotoğrafı çekebilmen için. Kamera yalnızca Fotoğraf Çek'e dokunduğunda açılır."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så att du kan ta en profilbild utan att lämna NestZone. Kameran öppnas bara när du trycker på Ta en bild."
          }
        }
      }
    }
  },
  "version" : "1.1"
}